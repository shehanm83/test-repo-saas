{
  "name": "vyora",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vyora/web dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm --filter @vyora/worker dev\"",
    "dev:offline-ai": "export QUEUE_MODE=elasticmq AI_MODE=mock; pnpm minio:bootstrap && pnpm queue:bootstrap && concurrently \"pnpm --filter @vyora/web dev\" \"pnpm --filter @vyora/worker dev\"",
    "dev:real-ai": "export QUEUE_MODE=elasticmq AI_MODE=real; pnpm minio:bootstrap && pnpm queue:bootstrap && concurrently \"pnpm --filter @vyora/web dev\" \"pnpm --filter @vyora/worker dev\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @vyora/db db:generate",
    "db:migrate": "pnpm --filter @vyora/db db:migrate",
    "db:studio": "pnpm --filter @vyora/db db:studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:pricebook": "pnpm --filter @vyora/db exec tsx scripts/seed-pricebook.ts",
    "minio:bootstrap": "./scripts/minio-bootstrap.sh",
    "queue:bootstrap": "./scripts/queue-bootstrap.sh",
    "staff:add": "tsx scripts/staff-add.ts",
    "worker:dev": "pnpm --filter @vyora/worker dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@vyora/auth": "workspace:*",
    "@vyora/db": "workspace:*",
    "@vyora/shared": "workspace:*"
  },
  "devDependencies": {
    "@clerk/backend": "^3.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jose": "^6.2.2",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
