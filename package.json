{
  "name": "studio-v1",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @studio/web dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm --filter @studio/worker dev\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @studio/db db:generate",
    "db:migrate": "pnpm --filter @studio/db db:migrate",
    "db:studio": "pnpm --filter @studio/db db:studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:pricebook": "pnpm --filter @studio/db exec tsx scripts/seed-pricebook.ts",
    "minio:bootstrap": "./scripts/minio-bootstrap.sh",
    "worker:dev": "pnpm --filter @studio/worker dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@studio/db": "workspace:*",
    "@studio/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "@clerk/backend": "^2.4.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jose": "^6.1.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
