{
  "name": "@vyora/observability",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./noop": "./src/noop.ts",
    "./sentry": "./src/sentry.ts",
    "./otel-stub": "./src/otel-stub.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
