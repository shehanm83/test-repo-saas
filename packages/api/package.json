{
  "name": "@layertone/api",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./billing": "./src/billing.ts",
    "./brand": "./src/brand.ts",
    "./caption": "./src/caption.ts",
    "./generation": "./src/generation.ts",
    "./generation-estimate": "./src/generation-estimate.ts",
    "./generation-preflight": "./src/generation-preflight.ts",
    "./quick-create-planner": "./src/quick-create-planner.ts",
    "./home-showcase": "./src/home-showcase.ts",
    "./inspiration": "./src/inspiration.ts",
    "./landing-hero": "./src/landing-hero.ts",
    "./mood": "./src/mood.ts",
    "./pricebook": "./src/pricebook.ts",
    "./product": "./src/product.ts",
    "./stock": "./src/stock.ts",
    "./template": "./src/template.ts",
    "./workspace": "./src/workspace.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=default",
    "test:int": "vitest run --reporter=default --config ../../vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@layertone/auth": "workspace:*",
    "@layertone/billing": "workspace:*",
    "@layertone/db": "workspace:*",
    "@layertone/observability": "workspace:*",
    "@layertone/shared": "workspace:*",
    "@layertone/storage": "workspace:*",
    "cheerio": "^1.2.0",
    "file-type": "^22.0.1",
    "isomorphic-dompurify": "^3.10.0",
    "node-vibrant": "^4.0.4",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "zod": "^4.3.6"
  }
}
