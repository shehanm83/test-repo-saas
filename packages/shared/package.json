{
  "name": "@layertone/shared",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./adapters": "./src/adapters/index.ts",
    "./adapters/types": "./src/adapters/types.ts",
    "./errors/app-error": "./src/errors/app-error.ts",
    "./errors/codes": "./src/errors/codes.ts",
    "./generation/commercial-contract": "./src/generation/commercial-contract.ts",
    "./generation/preflight": "./src/generation/preflight.ts",
    "./home-showcase": "./src/home-showcase.ts",
    "./landing-hero": "./src/landing-hero.ts",
    "./output-targets": "./src/output-targets/index.ts",
    "./prompt-templates": "./src/prompt-templates/index.ts",
    "./templates/schema": "./src/templates/schema.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=default",
    "test:int": "vitest run --reporter=default --config ../../vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@layertone/auth": "workspace:*",
    "@layertone/billing": "workspace:*",
    "@layertone/observability": "workspace:*",
    "@layertone/storage": "workspace:*",
    "yaml": "^2.8.4",
    "zod": "^4.3.6"
  }
}
