{
  "name": "@vyora/worker",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx scripts/dev.ts",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=default",
    "test:int": "vitest run --reporter=default --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sentry/node": "^10.50.0",
    "@vyora/billing": "workspace:*",
    "@vyora/db": "workspace:*",
    "@vyora/gateway": "workspace:*",
    "@vyora/observability": "workspace:*",
    "@vyora/queue": "workspace:*",
    "@vyora/renderer": "workspace:*",
    "@vyora/shared": "workspace:*",
    "@vyora/storage": "workspace:*",
    "drizzle-orm": "^0.45.2"
  }
}
