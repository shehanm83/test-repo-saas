{
  "name": "@layertone/worker",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./handler": "./src/handler.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=../../.env.local scripts/dev.ts",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=default",
    "test:int": "vitest run --reporter=default --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sentry/node": "^10.50.0",
    "@layertone/billing": "workspace:*",
    "@layertone/db": "workspace:*",
    "@layertone/gateway": "workspace:*",
    "@layertone/observability": "workspace:*",
    "@layertone/queue": "workspace:*",
    "@layertone/renderer": "workspace:*",
    "@layertone/shared": "workspace:*",
    "@layertone/storage": "workspace:*",
    "drizzle-orm": "^0.45.2"
  }
}
