{
  "name": "@vyora/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:lambda": "next build && open-next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=default",
    "test:int": "vitest run --reporter=default --config ../../vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.7",
    "@sentry/nextjs": "^10.50.0",
    "@vyora/api": "workspace:*",
    "@vyora/auth": "workspace:*",
    "@vyora/billing": "workspace:*",
    "@vyora/db": "workspace:*",
    "@vyora/gateway": "workspace:*",
    "@vyora/observability": "workspace:*",
    "@vyora/queue": "workspace:*",
    "@vyora/shared": "workspace:*",
    "@vyora/storage": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@opennextjs/aws": "^3.10.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2"
  }
}
